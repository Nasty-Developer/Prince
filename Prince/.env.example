# Safe template only. Copy to .env for local development; never commit .env.
# Render assigns PORT at runtime, so it is intentionally not set here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
NODE_ENV=production
BASE_PATH=/

# Server-side Firebase token verification and admin authorization
FIREBASE_PROJECT_ID=your-firebase-project-id
ADMIN_FIREBASE_UIDS=replace-with-admin-firebase-uid

# Browser Firebase configuration (public client values, not service credentials)
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_APP_ID=1:000000000000:web:replace-with-app-id
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project.firebasestorage.app
VITE_ADMIN_FIREBASE_UIDS=replace-with-admin-firebase-uid